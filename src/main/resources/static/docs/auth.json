{
  "openapi": "3.0.0",
  "info": {
    "title": "🍃 auth",
    "description": "Exported from Requestly API Client",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{BASE_URL}",
      "variables": {
        "BASE_URL": {
          "default": "http://localhost:8080/api/v1"
        }
      }
    }
  ],
  "paths": {
    "/auth/me": {
      "get": {
        "summary": "current user detail",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "get health",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "login user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "email": "saket@example.in",
                "password": "Password@123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "register user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "profilePicture": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "name": "Saket Maurya",
                "email": "saket@example.in",
                "password": "Password@123",
                "phone": "987654329",
                "profilePicture": "https://example.com/images/profile.jpg"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}